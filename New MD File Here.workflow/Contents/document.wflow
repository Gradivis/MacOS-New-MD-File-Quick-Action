				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>use AppleScript version "2.4"
use scripting additions

on run {input, parameters}
	tell application "Finder"
		set targetFolder to (insertion location) as alias
	end tell
	set folderPath to POSIX path of targetFolder

	set helperPath to (POSIX path of (path to home folder)) &amp; "Library/Services/New MD File Here.workflow/Contents/Resources/ArtemisHelper.app/Contents/MacOS/applet"
	set outPath to (do shell script "/usr/bin/mktemp /tmp/new-md-dialog.XXXXXX")

	try
		do shell script "NEW_MD_OUTPUT_PATH=" &amp; quoted form of outPath &amp; " " &amp; quoted form of helperPath
		set baseName to (do shell script "/bin/cat " &amp; quoted form of outPath)
	on error errMsg
		try
			do shell script "/bin/rm -f " &amp; quoted form of outPath
		end try
		display alert "Could not show dialog" message errMsg as critical
		return input
	end try
	do shell script "/bin/rm -f " &amp; quoted form of outPath

	set trimmedName to my trimWhitespace(baseName)
	if trimmedName is "" then return input -- cancelled or empty

	set finalName to my resolveUniqueName(folderPath, trimmedName)
	set fullPath to folderPath &amp; finalName

	try
		set fileRef to open for access POSIX file fullPath with write permission
		write "hello gorgeous" to fileRef as «class utf8»
		close access fileRef
	on error errMsg
		try
			close access POSIX file fullPath
		end try
		display alert "Could not create file" message errMsg as critical
		return input
	end try

	tell application "Finder"
		reveal (POSIX file fullPath as alias)
		activate
	end tell

	return input
end run

on trimWhitespace(theText)
	repeat while theText starts with " " or theText starts with tab
		set theText to text 2 thru -1 of theText
	end repeat
	repeat while theText ends with " " or theText ends with tab
		set theText to text 1 thru -2 of theText
	end repeat
	return theText
end trimWhitespace

on resolveUniqueName(folderPath, baseName)
	set candidate to baseName &amp; ".md"
	set counter to 2
	repeat while (my fileExists(folderPath &amp; candidate))
		set candidate to baseName &amp; " " &amp; counter &amp; ".md"
		set counter to counter + 1
	end repeat
	return candidate
end resolveUniqueName

on fileExists(posixPath)
	try
		posixPath as POSIX file as alias
		return true
	on error
		return false
	end try
end fileExists
</string>
